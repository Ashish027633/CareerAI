# Application Environment Profile (dev / prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# JWT Authentication Secret Key
# WARNING: Generate a secure 256-bit+ base64 key for production
JWT_SECRET=CareerAI_Super_Secret_Key_For_Phase2_Local_Development_Only_Replace_In_Prod!

# Google OAuth (Phase 2 integration)
GOOGLE_CLIENT_ID=placeholder-client-id
GOOGLE_CLIENT_SECRET=placeholder-client-secret

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Seed Demo Data (true/false)
SEED_DEMO_DATA=false

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerai
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
